generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Market {
  id              String    @id // Market PDA pubkey (base58)
  marketId        BigInt    @unique
  title           String
  description     String    @default("")
  fredSeriesId    String
  marketType      String // "binary" | "multiOutcome"
  numOutcomes     Int
  outcomeLabels   Json // Array of outcome label strings
  status          String    @default("pending")
  proposer        String
  creator         String?
  tokenMint       String
  vault           String?
  totalSetsMinted BigInt    @default(0)
  closesAt        DateTime
  resolvesAt      DateTime
  resolvedAt      DateTime?
  winningOutcome  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([fredSeriesId])
}

model FredCache {
  seriesId     String   @id
  observations Json     // Array of {date, value, realtime_start, realtime_end}
  seriesInfo   Json?    // Optional: series metadata (title, units, frequency, etc.)
  lastFetched  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lastFetched])
}
