generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Market {
  id              String    @id // Market PDA pubkey (base58)
  marketId        BigInt    @unique
  title           String
  description     String    @default("")
  fredSeriesId    String
  marketType      String // "binary" | "multiOutcome"
  numOutcomes     Int
  outcomeLabels   String[]
  status          String    @default("pending")
  proposer        String
  creator         String?
  tokenMint       String
  vault           String?
  totalSetsMinted BigInt    @default(0)
  closesAt        DateTime
  resolvesAt      DateTime
  resolvedAt      DateTime?
  winningOutcome  Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([fredSeriesId])
}
