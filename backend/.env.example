PORT=3001

# Neon PostgreSQL Connection
# Get from: Neon Console > Your Project > Connection Details
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
# Note: Neon provides built-in connection pooling, no separate pooler URL needed
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# FRED API
# Get free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Frontend URL (update to deployed Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ─── Oracle Relay ─────────────────────────────────────────────────────────────
# The oracle keypair is the Solana account whose public key was passed as
# oracle_authority when initialize_platform was called on-chain.
#
# Two supported formats:
#   Base64:     cat keypair.json | python3 -c "import sys,json,base64; print(base64.b64encode(bytes(json.load(sys.stdin))).decode())"
#   JSON array: cat ~/.config/solana/oracle-keypair.json   (paste directly)
#
# NEVER commit this value. Add to Railway / Vercel environment variables only.
ORACLE_KEYPAIR=

# Solana RPC endpoint (use a paid RPC for production to avoid rate limits)
SOLANA_RPC_URL=https://api.devnet.solana.com

# Anchor program ID (matches declare_id! in fred_markets/programs/fred_markets/src/lib.rs)
FRED_MARKETS_PROGRAM_ID=GaK745UiF6FMZt5hXbCrKQrhmdcmRx8SYi3AdfFshMBo

# Oracle cron schedule (default: every 15 minutes)
# Use "*/5 * * * *" for faster testing, "0 * * * *" for hourly production
ORACLE_CRON_SCHEDULE=*/15 * * * *

# Secret for POST /api/oracle/trigger (manual trigger endpoint)
# Leave empty to disable the endpoint. Generate with: openssl rand -hex 32
ORACLE_ADMIN_SECRET=
