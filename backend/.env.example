PORT=3001

# Neon PostgreSQL Connection
# Get from: Neon Console > Your Project > Connection Details
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[database]?sslmode=require
# Note: Neon provides built-in connection pooling, no separate pooler URL needed
DATABASE_URL=postgresql://[user]:[password]@[endpoint].neon.tech/neondb?sslmode=require

# FRED API
# Get free API key from: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Frontend URL (update to deployed Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development
