PORT=3001

# Supabase PostgreSQL Connection (Transaction Mode - Pooler)
# Get from: Supabase Dashboard > Settings > Database > Connection String
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Direct Connection (for migrations)
# Get from: Supabase Dashboard > Settings > Database > Connection String (Session mode)
# Format: postgres://postgres.[project-ref]:[password]@aws-0-[region].compute.amazonaws.com:5432/postgres
DIRECT_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].compute.amazonaws.com:5432/postgres

# FRED API
FRED_API_KEY=your_fred_api_key_here

# Frontend
FRONTEND_URL=http://localhost:3000

# Environment
NODE_ENV=development
