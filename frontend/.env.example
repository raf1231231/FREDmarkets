# ─── FREDmarkets Frontend — Environment Variables ──────────────────────────────
# Copy this file to .env.local and fill in values before running `npm run dev`
# .env.local is gitignored — never commit actual secrets

# ─── Backend API ───────────────────────────────────────────────────────────────
# Local development: http://localhost:3001/api
# Production:        https://your-backend.up.railway.app/api  (Railway URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# ─── Solana ────────────────────────────────────────────────────────────────────
# Devnet (default for local dev and staging):
#   https://api.devnet.solana.com
# Mainnet (production only — after contract audit):
#   https://api.mainnet-beta.solana.com
# Recommended: use a paid RPC (Helius, QuickNode, Triton) for production
#   to avoid public RPC rate limits.
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com
